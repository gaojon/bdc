{
  "deepseek": {
    "api_key": "sk-your-api-key-here",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-chat",
    "timeout_seconds": 120
  },
  "article": {
    "target_word_count": 500,
    "min_hit_words": 25,
    "max_hit_words": 50,
    "max_word_pool_size": 500
  },
  "limits": {
    "daily_generation_limit": 3,
    "article_history_retention": 24
  },
  "spaced_repetition": {
    "intervals": [1, 3, 7, 21, 60]
  }
}
